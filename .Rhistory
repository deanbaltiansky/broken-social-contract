mutate(income = factor(income,c("$0-$20,000",
"$20,001-$40,000",
"$40,001-$60,000",
"$60,001-$80,000",
"$80,001-$100,000",
"$100,001-$120,000",
"$120,001-$140,000",
"$140,001-$160,000",
"$160,001-$180,000",
"$180,001-$200,000",
"Over $200,000")),
edu = factor(edu,c("noHS",
"GED",
"2yearColl",
"4yearColl",
"MA",
"PHD")),
county_gini = as.numeric(county_gini),
county_density = as.numeric(county_density),
county_medianincome = as.numeric(county_medianincome))
