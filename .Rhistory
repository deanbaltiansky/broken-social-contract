library(lsa)
library(tidyverse)
elg <- read.csv("~/Google Drive/My Drive/american's dream/March 2024/data/df_bsc.csv") %>%
filter(check_1 == 0 & check_2 == 0) %>%
dplyr::select(PID) %>%
distinct()
df_bscwords_long <- read.csv("~/Google Drive/My Drive/american's dream/March 2024/data/df_bscwords_long_foropenai.csv")
all_simis <- read.csv("~/Google Drive/My Drive/american's dream/March 2024/data/all_simis_openai.csv")
value_vecs <- read.csv("~/Google Drive/My Drive/american's dream/March 2024/data/value_vecs_openai.csv")
df_bscwords_long <- df_bscwords_long %>%
inner_join(elg,by = "PID")
papervalues <- df_bscwords_long %>%
filter(type == "uspaper") %>%
dplyr::select(value) %>%
distinct() %>%
unname() %>%
unlist()
values_forkmeans <- value_vecs %>%
filter(value %in% papervalues)
library(stats)
library(factoextra)
value_mtrx <- values_forkmeans %>%
select(-t.c.i..current_embedding..) %>%
as.matrix()
library(factoextra)
library(NbClust)
set.seed(20240508)
# Elbow method
# fviz_nbclust(mt_valuevectors, kmeans, method = "wss") +
#   #geom_vline(xintercept = 2, linetype = 2)+
#   labs(subtitle = "Elbow method")
#
# # Silhouette method
# #jpeg("silhouette.jpeg",width = 480,height = 360)
# fviz_nbclust(mt_valuevectors, kmeans, method = "silhouette")+
#   labs(subtitle = "Silhouette method")
#
# # Gap statistic
# fviz_nbclust(mt_valuevectors, kmeans, nstart = 25,  method = "gap_stat")+
#   labs(subtitle = "Gap statistic method")
mentions <- df_bscwords_long %>%
filter(type == "uspaper") %>%
group_by(value) %>%
summarise(n = n()) %>%
ungroup()
values_forkmeans <- value_vecs %>%
filter(value %in% papervalues)
mentions_more <- mentions %>%
filter(n > 1) %>%
dplyr::select(value)
values_forkmeans <- values_forkmeans %>%
inner_join(mentions_more, by = "value")
value_mtrx <- values_forkmeans %>%
as.matrix()
clusters <- data.frame(k8$cluster) %>%
mutate(value = rownames(data.frame(k8$cluster)))
set.seed(20240508)
k8 <- kmeans(mt_valuevectors, centers = 8, nstart = 25)
mentions <- df_bscwords_long %>%
filter(type == "uspaper") %>%
group_by(value) %>%
summarise(n = n()) %>%
ungroup()
values_forkmeans <- value_vecs %>%
filter(value %in% papervalues)
mentions_more <- mentions %>%
filter(n > 1) %>%
dplyr::select(value)
values_forkmeans <- values_forkmeans %>%
inner_join(mentions_more, by = "value")
value_mtrx <- values_forkmeans %>%
as.matrix()
my_rownames = values_forkmeans %>%
dplyr::select(value) %>%
unlist() %>%
unname()
mt_valuevectors <- value_mtrx[,2:3073]
rownames(mt_valuevectors) <- my_rownames
mt_valuevectors <- data.frame(mt_valuevectors) %>%
mutate_at(vars(X2:X3073),function(x){as.numeric(x)}) %>%
as.matrix()
set.seed(20240508)
k8 <- kmeans(mt_valuevectors, centers = 8, nstart = 25)
clusters <- data.frame(k8$cluster) %>%
mutate(value = rownames(data.frame(k8$cluster)))
df_valueclusters <- values_forkmeans %>%
dplyr::select(value) %>%
'rownames<-'(NULL) %>%
left_join(clusters,by = "value")
mentions <- df_bscwords_long %>%
filter(type == "uspaper") %>%
group_by(value) %>%
summarise(n = n()) %>%
ungroup()
df_valueclusters <- df_valueclusters %>%
left_join(mentions,by = "value")
labels_to_keep <- df_valueclusters %>%
arrange(desc(n)) %>%
group_by(k8.cluster) %>%
slice(1:6) %>%
ungroup() %>%
select(value) %>%
distinct() %>%
unlist() %>%
unname()
# Create a data frame with the clustering results and PCA components for visualization
pca_result <- prcomp(mt_valuevectors, scale. = TRUE)
pca_data <- data.frame(pca_result$x[, 1:2])
pca_data$Cluster <- as.factor(k8$cluster)
pca_data$Label <- rownames(mt_valuevectors)
?pmng
?png
