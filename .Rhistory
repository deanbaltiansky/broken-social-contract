library(tidyverse)
df_raw_cnct_char <- read.csv("~/Google Drive/My Drive/left behind/oct25a/data/lebe_oct25a_cnct_raw_char.csv")
df_raw_cnct_num <- read.csv("~/Google Drive/My Drive/left behind/oct25a/data/lebe_oct25a_cnct_raw_num.csv")
df_raw_prol_char <- read.csv("~/Google Drive/My Drive/left behind/oct25a/data/lebe_oct25a_prol_raw_char.csv")
df_raw_prol_num <- read.csv("~/Google Drive/My Drive/left behind/oct25a/data/lebe_oct25a_prol_raw_num.csv")
df_raw_cnct_num <- df_raw_cnct_num %>%
slice(-(1:2))
df_raw_prol_num <- df_raw_prol_num %>%
slice(-(1:5))
df_raw_cnct <- df_raw_cnct_num %>%
dplyr::select(-c(vote_turnout,
vote_who_y,
vote_who_n,
vote_who_y_3_TEXT,
vote_who_n_3_TEXT,
gender,
race_1:race_8,
income,
edu,
party_gen:party_ind)) %>%
left_join(df_raw_cnct_char %>% dplyr::select(ResponseId,
vote_turnout,
vote_who_y,
vote_who_n,
vote_who_y_3_TEXT,
vote_who_n_3_TEXT,
gender,
race_1:race_8,
income,
edu,
party_gen:party_ind),
by = "ResponseId") %>%
select(-participantId)
df_raw_prol <- df_raw_prol_num %>%
dplyr::select(-c(vote_turnout,
vote_who_y,
vote_who_n,
vote_who_y_3_TEXT,
vote_who_n_3_TEXT,
gender,
race_1:race_8,
income,
edu,
party_gen:party_ind)) %>%
left_join(df_raw_prol_char %>% dplyr::select(ResponseId,
vote_turnout,
vote_who_y,
vote_who_n,
vote_who_y_3_TEXT,
vote_who_n_3_TEXT,
gender,
race_1:race_8,
income,
edu,
party_gen:party_ind),
by = "ResponseId") %>%
select(-PROLIFIC_PID)
df_raw <- df_raw_cnct %>%
bind_rows(df_raw_prol)
# Function to generate a single code
generate_code <- function() {
upper <- paste0(sample(LETTERS, 2, replace = TRUE), collapse = "")
digits <- paste0(sample(0:9, 3, replace = TRUE), collapse = "")
lower <- paste0(sample(letters, 2, replace = TRUE), collapse = "")
paste0(upper, digits, lower)
}
# Generate codes based on the number of rows in df_raw
num_codes <- nrow(df_raw)
codes <- replicate(num_codes, generate_code())
df_raw_deid <- df_raw %>%
dplyr::select(Status,Progress:Finished,consent:party_ind) %>%
mutate(PID = codes) %>%
dplyr::select(PID,everything())
write.csv(df_raw_deid,"~/Google Drive/My Drive/left behind/left behind - github/left-behind/study-oct25a/data/df_raw_deid.csv",row.names = F)
detachAllPackages <- function() {
basic.packages <- c("package:stats","package:graphics","package:grDevices","package:utils","package:datasets","package:methods","package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:",search()))==1,TRUE,FALSE)]
package.list <- setdiff(package.list,basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package, character.only=TRUE)
}
detachAllPackages()
