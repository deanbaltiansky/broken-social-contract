# All value broken models



```{r,results='asis',echo=TRUE,warning=FALSE,message=FALSE}
five_dvs = c("antiest_z","change_z","trust_deminst_z","trust_natinst_z","vote_likely_z")
eight_values = c("democracy_z","equality_z","freedom_z","individualism_z","justice_z","happiness_z","arms_z","tolerance_z")

df_modeloutputs = tibble(dv = NA,
                        pred = NA,
                        b = NA,
                        t = NA,
                        low_CI = NA,
                        high_CI = NA,
                        p = NA)

for (outcome in five_dvs){
  for (value in eight_values){
    
    formula = paste0(outcome,"~",value,"+ SDO_z + TIPI_agree_z + gender + race + hispanic + income_num_z + edu_num_z + age_z + county_medianincome_z + county_gini_z + county_density_z")
    
    m = lm(formula,data = df_bsc_elg)
    
    coef <- m$coefficients[value]
    t_value <- coef(summary(m))[value,"t value"]
    CI_low <- confint(m)[value,1]
    CI_high <- confint(m)[value,2]
    p_value <- coef(summary(m))[value,"Pr(>|t|)"]
    
    df_current = tibble(dv = outcome,
                        pred = value,
                        b = coef,
                        t = t_value,
                        low_CI = CI_low,
                        high_CI = CI_high,
                        p = p_value)
    
    df_modeloutputs <- df_modeloutputs %>% 
      bind_rows(df_current)
  }
}

df_modeloutputs %>% 
  write.csv("table_2.csv",row.names = F)
